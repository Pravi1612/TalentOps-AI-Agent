# --- LLM provider ---------------------------------------------------------
# Auto-detection: if ANTHROPIC_API_KEY is set to a real key, "anthropic"
# is used; otherwise the backend falls back to "mock" (deterministic
# stub responses, no API needed, ideal for demos/dev).
# Override explicitly with LLM_PROVIDER=mock or LLM_PROVIDER=anthropic.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Server ---------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
OUTPUT_DIR=./output
